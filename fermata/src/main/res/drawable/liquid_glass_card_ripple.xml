<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#6636D6FF">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="#A6205270" />
                    <stroke
                        android:width="2dp"
                        android:color="#FF5DE4FF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="#B116719A" />
                    <stroke
                        android:width="1dp"
                        android:color="#CCFFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient
                        android:angle="270"
                        android:endColor="#5211263E"
                        android:startColor="#753B5870" />
                    <stroke
                        android:width="1dp"
                        android:color="#70FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
